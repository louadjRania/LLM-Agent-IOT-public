# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# ---- LLM providers (set only the ones you intend to run) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- ThingsBoard MQTT broker ----
THINGSBOARD_HOST=localhost
THINGSBOARD_PORT=1883
THINGSBOARD_HTTP_PORT=8080
TB_EMAIL=
TB_PASSWORD=

# ---- ThingsBoard device access tokens ----
MACHINE_A_TOKEN=
CONVEYOR_B_TOKEN=
QUALITY_SENSOR_C_TOKEN=
ENERGY_MONITOR_D_TOKEN=
MACHINE_A_FALSIFIED_TOKEN=
CASCADE_STATUS_TOKEN=
ATTACK_MONITOR_TOKEN=
